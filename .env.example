# Google Ads Studio: biến môi trường.
# Chạy local: chép file này thành .env.local rồi điền. Deploy: điền ở Vercel → Settings → Environment Variables.
# Không bao giờ commit giá trị thật. Bảng giải thích từng biến: README.md, mục "Biến môi trường".

# ── Bắt buộc ───────────────────────────────────────────────────────────────
# URL gốc của web (không có / ở cuối). Local: http://localhost:3000
NEXTAUTH_URL=
# Chuỗi ngẫu nhiên dài, ký phiên đăng nhập và link connector Claude. Tạo bằng: openssl rand -base64 32
# Đổi giá trị này = mọi người bị đăng xuất và mọi link connector cũ hết hiệu lực.
NEXTAUTH_SECRET=
# JSON của service account Google (một dòng). Đọc/ghi sheet hệ thống: Users, LoginLog, UsageLog.
GOOGLE_SERVICE_ACCOUNT_JSON=
# ID Google Sheet hệ thống (đoạn giữa /d/ và /edit trong link). Share sheet cho email service account, quyền Editor.
# Bỏ trống thì dùng sheet của team gốc (chỉ chạy được nếu service account của bạn có quyền vào sheet đó).
SYSTEM_SHEET_ID=
# Gen ảnh, brief, mascot, localize banner, Outro Studio.
OPENAI_API_KEY=
# Ad Copy Studio: keyword, ad copy, localize ad copy.
ANTHROPIC_API_KEY=

# ── Launch Camp (tạo campaign trên Google Ads) ─────────────────────────────
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_MCC_CUSTOMER_ID=

# ── YouTube Upload ─────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_BASE_URL=

# ── Tuỳ chọn ───────────────────────────────────────────────────────────────
# Mẫu link nút "Mở MKT System", được chứa {tag}, {from}, {to}. Bỏ trống = trang Creative của mktpro.aperogroup.ai.
MKT_SYSTEM_URL=
# Competitor Ads.
SENSORTOWER_API_KEY=
# Đăng nhập SSO Keycloak (trang đăng nhập hiện chỉ dùng tài khoản trong sheet Users).
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ISSUER=

# ── Chỉ cho bộ lệnh chat (chat/studio.mjs), đặt trong Environment của Claude Code, không đặt trên Vercel ──
# MKT_CONNECT_CODE=mktmcp_...     (MKT System → Profile → Kết nối Claude, hết hạn sau ~24 giờ)
# GAIC_CONNECTOR_URL=https://.../api/mcp/gaic_...   (web → MKT System → "Lấy link connector của tôi")
